# Neon Postgres (dùng connection string dạng pooler từ Neon console)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Secret ký JWT session — sinh bằng: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
AUTH_SECRET=thay-bang-chuoi-base64-32-byte
